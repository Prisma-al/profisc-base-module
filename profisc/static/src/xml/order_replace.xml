<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="profisc.Ord"
       t-inherit="point_of_sale.ActionpadWidget"
       t-inherit-mode="extension">

      <!-- Replace the original Order button with Order to Kitchen button,
           keeping t-if to preserve the t-elif chain in the restaurant template -->
        <xpath expr="//button[hasclass('submit-order')]" position="replace">
            <button
                class="submit-order h-100 button btn btn-lg d-flex align-items-center w-50 flex-fill position-relative px-3 highlight btn-primary justify-content-between"
                t-if="!this.currentOrder.isDirectSale and this.displayCategoryCount.length"
                t-on-click="onClickSendOrder"
            >Order to Kitchen
            </button>
        </xpath>
    </t>
</templates>