<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="profisc_wtn_vehicles" model="ir.ui.view">
        <field name="name">profisc.wtn_vehicles.form</field>
        <field name="model">profisc.wtn_vehicles</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="plate"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="profisc_wtn_business_units" model="ir.ui.view">
        <field name="name">profisc.profisc_wtn_business_units.form</field>
        <field name="model">profisc.business_units</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="profisc_wtn_tcr" model="ir.ui.view">
        <field name="name">profisc.profisc_wtn_tcr.form</field>
        <field name="model">profisc.tcr</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="bu_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="profisc_uoms_form" model="ir.ui.view">
        <field name="name">profisc.uoms.form</field>
        <field name="model">profisc.uoms</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="is_active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="profisc_uoms_tree" model="ir.ui.view">
        <field name="name">profisc.uoms.list</field>
        <field name="model">profisc.uoms</field>
        <field name="arch" type="xml">
            <list string="Profisc Uoms">
                <field name="name"/>
                <field name="code"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>


    <record id="action_profisc_uoms" model="ir.actions.act_window">
        <field name="name">Uoms Management</field>
        <field name="res_model">profisc.uoms</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="profisc_uoms_tree"/>
    </record>
    <record id="action_profisc_wtn_vehicles" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">profisc.wtn_vehicles</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_profisc_wtn_business_units" model="ir.actions.act_window">
        <field name="name">Business Units</field>
        <field name="res_model">profisc.business_units</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_profisc_wtn_tcr" model="ir.actions.act_window">
        <field name="name">TCR</field>
        <field name="res_model">profisc.tcr</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_profisc_management" name="Profisc management" sequence="10"/>
    <menuitem id="menu_bu_tcr" name="BU/TCR management" sequence="11" parent="menu_profisc_management"/>

    <menuitem id="menu_profisc_wtn_vehicles" name="Vehicle Management" sequence="12"
              action="action_profisc_wtn_vehicles"
              parent="menu_profisc_management"/>
    <menuitem id="menu_profisc_uoms" name="Uoms" sequence="15"
              action="action_profisc_uoms"
              parent="menu_profisc_management"/>
    <menuitem id="menu_profisc_wtn_business_units" name="BU Management" sequence="13"
              action="action_profisc_wtn_business_units"
              parent="menu_bu_tcr"/>
    <menuitem id="menu_profisc_wtn_tcr" name="TCR Management" sequence="14"
              action="action_profisc_wtn_tcr"
              parent="menu_bu_tcr"/>


</odoo>
